{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vulmarjunior/siteibopvh/docs/planos/E1/esquema-importacao.schema.json",
  "title": "EBD Digital — importação de trimestre",
  "description": "Contrato do JSON extraído localmente e importado no admin do portal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "edition", "lessons"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sha256", "page_count", "size_bytes"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "page_count": { "type": "integer", "minimum": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "title", "year", "quarter", "class"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900 },
        "quarter": { "type": "integer", "minimum": 1, "maximum": 4 },
        "issue": { "type": ["integer", "null"], "minimum": 1 },
        "volume": { "type": ["integer", "null"], "minimum": 1 },
        "class": { "type": "string", "minLength": 1 }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "title",
          "base_text",
          "start_page",
          "end_page",
          "introduction",
          "sections",
          "questions",
          "daily_readings"
        ],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "base_text": { "type": "string", "minLength": 1 },
          "start_page": { "type": "integer", "minimum": 1 },
          "end_page": { "type": "integer", "minimum": 1 },
          "introduction": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["number", "title", "paragraphs"],
              "properties": {
                "number": { "type": "integer", "minimum": 1 },
                "title": { "type": "string", "minLength": 1 },
                "paragraphs": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "references": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["number", "text"],
              "properties": {
                "number": { "type": "integer", "minimum": 1 },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          },
          "daily_readings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["day", "reference"],
              "properties": {
                "day": {
                  "enum": ["SEG", "TER", "QUA", "QUI", "SEX", "SÁB", "DOM"]
                },
                "reference": { "type": "string", "minLength": 1 }
              }
            }
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page"],
              "properties": {
                "page": { "type": "integer", "minimum": 1 },
                "caption": { "type": ["string", "null"] },
                "alt": { "type": ["string", "null"] }
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "source_hash"],
            "properties": {
              "status": {
                "enum": ["draft", "reviewed", "published"]
              },
              "reviewer": { "type": ["string", "null"] },
              "reviewed_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "source_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
