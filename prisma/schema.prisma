// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Reservation {
  id              Int       @id @default(autoincrement())
  date            String    // "2026-07-01"
  timeStart       String    // "06:00"
  timeEnd         String    // "07:00"
  name            String
  email           String
  prayerThemes    String?   // JSON string array
  personalRequest String?
  cancelToken     String    @unique
  reservedAt      DateTime  @default(now())
  cancelledAt     DateTime?

  @@index([date, timeStart])
}

model Config {
  key   String @id
  value String
}

model HomeBannerSlide {
  id          String   @id @default(cuid())
  subtitle    String
  title       String
  description String
  ctaLabel    String
  ctaLink     String
  imageUrl    String
  altText     String
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, position])
}

model PrayerTheme {
  id     Int     @id @default(autoincrement())
  label  String
  active Boolean @default(true)
  order  Int     @default(0)
}

model EbfRegistration {
  id            Int       @id @default(autoincrement())
  editionId     String
  edition       SiteEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  childName     String
  age           Int
  colorGroup    String
  guardianName  String
  phone         String
  visitor       Boolean
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?

  @@index([colorGroup])
  @@index([createdAt])
  @@index([editionId, createdAt])
}

model ReadingSubscriber {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  name           String?
  token          String     @unique
  active         Boolean    @default(true)
  subscribedAt   DateTime   @default(now())
  unsubscribedAt DateTime?
  deliveries     EditorialEmailDelivery[]
}

enum SiteModuleStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}

enum SiteDirectAccessPolicy {
  AVAILABLE
  CLOSING_PAGE
  UNAVAILABLE
}

model SiteModule {
  id                   String                   @id
  name                 String
  path                 String                   @unique
  status               SiteModuleStatus         @default(DRAFT)
  visibleOnHome        Boolean                  @default(false)
  visibleInNavigation  Boolean                  @default(false)
  directAccess         SiteDirectAccessPolicy   @default(UNAVAILABLE)
  publicOperationsOpen Boolean                  @default(false)
  permanent            Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  editions             SiteEdition[]

  @@index([status])
  @@index([visibleOnHome, status])
  @@index([visibleInNavigation, status])
}

model SiteEdition {
  id        String           @id @default(cuid())
  moduleId  String
  module    SiteModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  year      Int?
  status    SiteModuleStatus @default(DRAFT)
  startsAt  DateTime?
  endsAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  ebfRegistrations EbfRegistration[]

  @@unique([moduleId, slug])
  @@index([moduleId, status])
  @@index([status, startsAt, endsAt])
}

enum EditorialSeriesStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ENDED
  ARCHIVED
}

enum EditorialMessageStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum EditorialMediaType {
  VIDEO
  AUDIO
  IMAGE
}

enum EditorialEmailRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum EditorialEmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model EditorialSeries {
  id                  String                @id @default(cuid())
  slug                String                @unique
  title               String
  subtitle            String?
  description         String?
  status              EditorialSeriesStatus @default(DRAFT)
  startsAt            DateTime?
  endsAt              DateTime?
  publishedAt         DateTime?
  defaultThumbnailUrl String?
  emailEnabled        Boolean               @default(false)
  capabilities        Json                  @default("{}")
  customFields        Json                  @default("{}")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  sections            EditorialSection[]
  messages            EditorialMessage[]
  emailRuns           EditorialEmailRun[]

  @@index([status, publishedAt])
  @@index([startsAt, endsAt])
}

model EditorialSection {
  id        String            @id @default(cuid())
  seriesId  String
  series    EditorialSeries   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  EditorialMessage[]

  @@unique([seriesId, slug])
  @@index([seriesId, order])
}

model EditorialMessage {
  id              String                 @id @default(cuid())
  seriesId        String
  series          EditorialSeries        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  sectionId       String?
  section         EditorialSection?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  slug            String
  order           Int
  title           String
  subtitle        String?
  scheduledFor    DateTime
  biblicalText    String
  speaker         String?
  summary         String?
  description     String?
  contentHtml     String?
  sourceSystem    String?
  externalId      String?
  lastSyncedAt    DateTime?
  status          EditorialMessageStatus @default(DRAFT)
  publishedAt     DateTime?
  customFields    Json                    @default("{}")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  media           EditorialMedia[]
  materials       EditorialMaterial[]
  readingPlan     EditorialReadingPlan?
  emailRuns       EditorialEmailRun[]

  @@unique([seriesId, slug])
  @@unique([seriesId, order])
  @@unique([sourceSystem, externalId])
  @@index([seriesId, status, scheduledFor])
  @@index([sectionId, order])
}

model EditorialEmailRun {
  id          String                  @id @default(cuid())
  seriesId    String
  series      EditorialSeries         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  messageId   String
  message     EditorialMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  status      EditorialEmailRunStatus @default(RUNNING)
  recipientCount Int                  @default(0)
  sentCount   Int                     @default(0)
  failedCount Int                     @default(0)
  startedAt   DateTime                @default(now())
  completedAt DateTime?
  error       String?
  deliveries EditorialEmailDelivery[]

  @@unique([seriesId, messageId, weekStart])
  @@index([seriesId, startedAt])
  @@index([messageId])
}

model EditorialEmailDelivery {
  id           String                       @id @default(cuid())
  runId        String
  run          EditorialEmailRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  subscriberId Int
  subscriber   ReadingSubscriber            @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status       EditorialEmailDeliveryStatus @default(PENDING)
  providerId   String?
  error        String?
  sentAt       DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@unique([runId, subscriberId])
  @@index([subscriberId, createdAt])
  @@index([runId, status])
}

model EditorialMedia {
  id           String             @id @default(cuid())
  messageId    String
  message      EditorialMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type         EditorialMediaType
  title        String?
  url          String
  provider     String?
  externalId   String?
  thumbnailUrl String?
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([messageId, type, order])
}

model EditorialMaterial {
  id        String           @id @default(cuid())
  messageId String
  message   EditorialMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  title     String
  type      String
  url       String
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([messageId, order])
}

model EditorialReadingPlan {
  id        String                 @id @default(cuid())
  messageId String                 @unique
  message   EditorialMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  theme     String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  days      EditorialReadingDay[]
}

model EditorialReadingDay {
  id          String               @id @default(cuid())
  planId      String
  plan        EditorialReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  order       Int
  dayLabel    String
  biblicalText String
  description String?

  @@unique([planId, order])
  @@index([planId, order])
}

// ==========================================
// MÓDULO VEREDAS IBO (CURADORIA TEOLÓGICA)
// ==========================================

enum CuradoriaTipoItem {
  VIDEO
  LIVRO
  CURSO
}

enum CuradoriaNivel {
  INTRODUTORIO
  INTERMEDIARIO
  APROFUNDAMENTO
}

enum CuradoriaStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum CuradoriaDisponibilidade {
  DISPONIVEL
  GRATUITO
  SOMENTE_DIGITAL
  ESGOTADO
  FORA_DE_CATALOGO
  AQUISICAO_NAO_LOCALIZADA
  INDISPONIVEL_TEMPORARIAMENTE
}

enum CuradoriaPapelPessoa {
  AUTOR
  ORGANIZADOR
  TRADUTOR
  PREFACIADOR
  EXPOSITOR
  PREGADOR
  ENTREVISTADOR
  ENTREVISTADO
  DEBATEDOR
}

enum CuradoriaTipoAcesso {
  COMPRA
  LEITURA_ONLINE
  DOWNLOAD_INTEGRAL
  AMOSTRA
  PAGINA_OFICIAL
  EMPRESTIMO
  MATERIAL_COMPLEMENTAR
}

enum CuradoriaFormatoAcesso {
  IMPRESSO
  PDF
  EPUB
  KINDLE
  WEB
  VIDEO
  OUTRO
}

enum CuradoriaProvedorAcesso {
  AMAZON
  EDITORA
  LIVRARIA
  ESTANTE_VIRTUAL
  GOOGLE_DRIVE
  ONEDRIVE
  SITE_AUTOR
  SITE_INSTITUCIONAL
  BIBLIOTECA_DIGITAL
  OUTRO
}

enum CuradoriaMotivoRelato {
  LINK_NAO_ABRE
  PAGINA_NAO_ENCONTRADA
  CONTEUDO_REMOVIDO
  EXIGE_LOGIN
  NAO_E_MAIS_GRATUITO
  CONTEUDO_INCORRETO
  REDIRECIONAMENTO_INDESEJADO
  OUTRO
}

enum CuradoriaStatusRelato {
  PENDENTE
  EM_ANALISE
  RESOLVIDO
  DESCARTADO
}

enum CuradoriaPapelUsuario {
  ADMIN
  CURADOR
  EDITOR
  OPERADOR
}

model CuradoriaItem {
  id              Int                     @id @default(autoincrement())
  tipo            CuradoriaTipoItem
  titulo          String
  slug            String                  @unique
  resumo          String
  descricao       String?
  porqueIndicamos String
  ressalvas       String?
  publicoIndicado String?
  nivel           CuradoriaNivel
  status          CuradoriaStatus
  destaque        Boolean                 @default(false)
  ordemDestaque   Int?
  imagemUrl       String?
  seoTitle        String?
  seoDescription  String?
  publicadoEm     DateTime?
  arquivadoEm     DateTime?
  criadoEm        DateTime                @default(now())
  atualizadoEm    DateTime                @updatedAt

  livro           CuradoriaLivro?
  video           CuradoriaVideo?
  curso           CuradoriaCurso?
  categorias      CuradoriaItemCategoria[]

  @@index([status, publicadoEm])
  @@index([tipo, status])
  @@index([destaque, status])
  @@index([nivel, status])
}

model CuradoriaLivro {
  id               Int                      @id @default(autoincrement())
  itemId           Int                      @unique
  item             CuradoriaItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)

  subtitulo        String?
  isbn10           String?
  isbn13           String?
  asin             String?
  editora          String?
  anoPublicacao    Int?
  edicao           String?
  idioma           String?
  numeroPaginas    Int?
  formatoPrincipal String?
  capaUrl          String?
  disponibilidade  CuradoriaDisponibilidade @default(DISPONIVEL)

  autores          CuradoriaLivroPessoa[]
  acessos          CuradoriaAcesso[]

  @@index([disponibilidade])
}

model CuradoriaVideo {
  id                  Int                    @id @default(autoincrement())
  itemId              Int                    @unique
  item                CuradoriaItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  youtubeId           String?
  urlOriginal         String
  canal               String?
  duracaoSegundos     Int?
  publicadoOriginalEm DateTime?
  thumbnailUrl        String?
  incorporavel        Boolean                @default(true)

  participantes       CuradoriaVideoPessoa[]

  @@index([youtubeId])
}

model CuradoriaCurso {
  id            Int                    @id @default(autoincrement())
  itemId        Int                    @unique
  item          CuradoriaItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  playlistId    String                 @unique
  urlOriginal   String
  canal         String?
  thumbnailUrl  String?
  aulas         CuradoriaCursoAula[]
  materiais     CuradoriaCursoMaterial[]

  @@index([itemId])
}

model CuradoriaCursoAula {
  id           Int             @id @default(autoincrement())
  cursoId      Int
  curso        CuradoriaCurso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  ordem        Int
  titulo       String
  youtubeId    String
  urlOriginal  String
  thumbnailUrl String?

  @@unique([cursoId, ordem])
  @@unique([cursoId, youtubeId])
  @@index([cursoId, ordem])
  @@index([youtubeId])
}

model CuradoriaCursoMaterial {
  id       Int            @id @default(autoincrement())
  cursoId  Int
  curso    CuradoriaCurso @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  ordem    Int
  titulo   String
  url      String

  @@unique([cursoId, ordem])
  @@index([cursoId, ordem])
}

model CuradoriaCategoria {
  id        Int                      @id @default(autoincrement())
  nome      String                   @unique
  slug      String                   @unique
  descricao String?
  ativa     Boolean                  @default(true)
  ordem     Int                      @default(0)

  itens     CuradoriaItemCategoria[]

  @@index([ativa, ordem])
}

model CuradoriaItemCategoria {
  itemId      Int
  categoriaId Int

  item        CuradoriaItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  categoria   CuradoriaCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([itemId, categoriaId])
  @@index([categoriaId])
  @@index([itemId])
}

model CuradoriaPessoa {
  id        Int                    @id @default(autoincrement())
  nome      String
  slug      String                 @unique
  descricao String?
  imagemUrl String?
  ativa     Boolean                @default(true)

  livros    CuradoriaLivroPessoa[]
  videos    CuradoriaVideoPessoa[]

  @@index([ativa])
}

model CuradoriaLivroPessoa {
  livroId  Int
  pessoaId Int
  papel    CuradoriaPapelPessoa @default(AUTOR)
  ordem    Int                  @default(0)

  livro    CuradoriaLivro       @relation(fields: [livroId], references: [id], onDelete: Cascade)
  pessoa   CuradoriaPessoa      @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@id([livroId, pessoaId, papel])
  @@index([pessoaId])
  @@index([livroId, ordem])
}

model CuradoriaVideoPessoa {
  videoId  Int
  pessoaId Int
  papel    CuradoriaPapelPessoa @default(EXPOSITOR)
  ordem    Int                  @default(0)

  video    CuradoriaVideo       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  pessoa   CuradoriaPessoa      @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@id([videoId, pessoaId, papel])
  @@index([pessoaId])
  @@index([videoId, ordem])
}

model CuradoriaAcesso {
  id                  Int                      @id @default(autoincrement())
  livroId             Int
  livro               CuradoriaLivro           @relation(fields: [livroId], references: [id], onDelete: Cascade)

  tipo                CuradoriaTipoAcesso
  formato             CuradoriaFormatoAcesso?
  provedor            CuradoriaProvedorAcesso?
  fornecedor          String?
  url                 String
  textoBotao          String
  gratuito            Boolean                  @default(false)
  linkAssociado       Boolean                  @default(false)
  producaoIbo         Boolean                  @default(false)
  ativo               Boolean                  @default(true)
  ordem               Int                      @default(0)
  observacaoPublica   String?
  fonte               String?
  ultimaVerificacaoEm DateTime?
  criadoEm            DateTime                 @default(now())
  atualizadoEm        DateTime                 @updatedAt

  relatos             CuradoriaLinkRelato[]

  @@index([livroId, ativo])
  @@index([gratuito, ativo])
  @@index([tipo, ativo])
}

model CuradoriaLinkRelato {
  id                Int                   @id @default(autoincrement())
  acessoId          Int
  acesso            CuradoriaAcesso       @relation(fields: [acessoId], references: [id], onDelete: Cascade)

  motivo            CuradoriaMotivoRelato
  observacao        String?
  status            CuradoriaStatusRelato @default(PENDENTE)

  ipHash            String?
  userAgentResumido String?

  criadoEm          DateTime              @default(now())
  analisadoEm       DateTime?
  resolvidoEm       DateTime?
  resolvidoPor      String?
  notaAdministrativa String?

  @@index([acessoId])
  @@index([status, criadoEm])
  @@index([ipHash, criadoEm])
}

model CuradoriaUsuario {
  id             String                @id
  email          String                @unique
  nome           String?
  papel          CuradoriaPapelUsuario @default(CURADOR)
  ativo          Boolean               @default(true)
  ultimoAcessoEm DateTime?
  criadoEm       DateTime              @default(now())
  atualizadoEm   DateTime              @updatedAt

  @@index([ativo])
  @@index([papel])
}

model CuradoriaAuditoria {
  id           Int      @id @default(autoincrement())
  usuarioId    String
  usuarioEmail String?
  acao         String
  entidade     String
  entidadeId   String
  dados        Json?
  criadoEm     DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([criadoEm])
}

model ApiRateLimitEvent {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([scope, keyHash, createdAt])
  @@index([createdAt])
}

