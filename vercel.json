{
  "buildCommand": "npx prisma generate && node scripts/process-ebf-gallery.mjs && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/veredas/:path*",
      "destination": "/api/veredas-entry?path=:path*"
    },
    { "source": "/api/admin/auth/:path*", "destination": "/api/admin-auth-entry?path=:path*" },
    { "source": "/api/admin/modules/:path*", "destination": "/api/admin-modules-entry?path=:path*" },
    { "source": "/api/admin/series-email/:path*", "destination": "/api/admin-series-email-entry?path=:path*" },
    { "source": "/api/admin/series/:path*", "destination": "/api/admin-series-entry?path=:path*" },
    { "source": "/api/admin/prayer/:path*", "destination": "/api/admin-prayer-entry?path=:path*" },
    { "source": "/api/admin/ebf/:path*", "destination": "/api/admin-ebf-entry?path=:path*" },
    { "source": "/api/admin/users/:path*", "destination": "/api/admin-users-entry?path=:path*" },
    { "source": "/api/admin/home-banners/:path*", "destination": "/api/admin-home-banners-entry?path=:path*" },
    {
      "source": "/api/:path((?!cron/weekly-reading$|health$|veredas(?:/.*)?$|admin(?:/.*)?$).*)",
      "destination": "/api/index"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-reading",
      "schedule": "0 11 * * 1"
    }
  ]
}
