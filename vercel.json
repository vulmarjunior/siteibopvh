{
  "buildCommand": "npx prisma generate && node scripts/process-ebf-gallery.mjs && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs24.x"
    },
    "api/cron/weekly-reading.ts": {
      "runtime": "nodejs24.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/weekly-reading",
      "destination": "/api/cron/weekly-reading"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-reading",
      "schedule": "0 11 * * 1"
    }
  ]
}